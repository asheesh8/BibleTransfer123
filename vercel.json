{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "app",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "trailingSlash": false,
  "functions": {
    "api/*.py": { "includeFiles": "packer/analytics.py" }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/english", "destination": "/english/index.html" },
    { "source": "/mandarin", "destination": "/mandarin/index.html" },
    { "source": "/hindi", "destination": "/hindi/index.html" },
    { "source": "/marathi", "destination": "/marathi/index.html" },
    { "source": "/urdu", "destination": "/urdu/index.html" },
    { "source": "/swahili", "destination": "/swahili/index.html" },
    { "source": "/luganda", "destination": "/luganda/index.html" },
    { "source": "/luo", "destination": "/luo/index.html" },
    { "source": "/dholuo", "destination": "/luo/index.html" },
    { "source": "/amharic", "destination": "/amharic/index.html" },
    { "source": "/amh", "destination": "/amharic/index.html" },
    { "source": "/french", "destination": "/french/index.html" },
    { "source": "/francais", "destination": "/french/index.html" },
    { "source": "/fra", "destination": "/french/index.html" },
    { "source": "/igbo", "destination": "/igbo/index.html" },
    { "source": "/ibo", "destination": "/igbo/index.html" },
    { "source": "/oromo", "destination": "/oromo/index.html" },
    { "source": "/afaan-oromoo", "destination": "/oromo/index.html" },
    { "source": "/kikuyu", "destination": "/kikuyu/index.html" },
    { "source": "/cantonese", "destination": "/cantonese/index.html" },
    { "source": "/pashto", "destination": "/pashto/index.html" },
    { "source": "/sindhi", "destination": "/sindhi/index.html" },
    { "source": "/gusii", "destination": "/gusii/index.html" },
    { "source": "/ekegusii", "destination": "/gusii/index.html" },
    { "source": "/kisii", "destination": "/gusii/index.html" },
    { "source": "/northern-pashto", "destination": "/pashto/index.html" },
    { "source": "/eastern-punjabi", "destination": "/eastern-punjabi/index.html" },
    { "source": "/punjabi", "destination": "/eastern-punjabi/index.html" },
    { "source": "/western-punjabi", "destination": "/western-punjabi/index.html" },
    { "source": "/shahmukhi", "destination": "/western-punjabi/index.html" },
    { "source": "/nepali", "destination": "/nepali/index.html" },
    { "source": "/zulu", "destination": "/zulu/index.html" },
    { "source": "/maasai", "destination": "/maasai/index.html" },
    { "source": "/masai", "destination": "/maasai/index.html" },
    { "source": "/share-libraries", "destination": "/share-libraries/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ]
}
