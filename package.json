{
  "name": "easytransfer",
  "version": "1.0.0",
  "private": true,
  "description": "Packs a media library onto a microSD card, with an offline app that opens itself.",
  "scripts": {
    "dev": "python3 packer/serve.py 8095",
    "preview": "python3 packer/easytransfer.py preview && python3 packer/serve.py 8095",
    "card": "python3 packer/easytransfer.py build --profile standard --out ./card",
    "serve:card": "python3 packer/serve.py 8095 --root ./card",
    "verify:card": "python3 packer/easytransfer.py verify --out ./card",
    "plan": "python3 packer/easytransfer.py plan --profile standard",
    "catalog": "python3 packer/easytransfer.py preview",
    "dbs:import": "python3 packer/import_dbs_rendered.py && python3 packer/enrich_local_online.py && python3 packer/easytransfer.py preview",
    "list": "python3 packer/easytransfer.py list"
  }
}
