# Locally, copy this file to .env.local; `npm run dev` loads it automatically.
# On Vercel, set these values in the project's server environment settings.
# Keep actual values outside Git. No client-side file should contain secrets.

# Required to sign in at /admin. Use a unique, randomly generated password.
EASYTRANSFER_ADMIN_PASSWORD=

# Optional independent signing secret (recommended). Rotating either the
# password or the signing secret invalidates existing sessions.
EASYTRANSFER_ADMIN_SECRET=

# Required in production: durable Upstash Redis REST credentials.
# Without them the production API reports 503 and stores no analytics.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional canonical origin for strict POST origin checks, for example:
# EASYTRANSFER_PUBLIC_ORIGIN=https://your-site.example
# Otherwise the request Host is used (HTTPS on Vercel, HTTP locally).
EASYTRANSFER_PUBLIC_ORIGIN=

# Optional local-only SQLite path. Default: .cache/analytics/events.sqlite.
# The server rejects a database path inside the folder it serves publicly.
# EASYTRANSFER_ANALYTICS_DB=/private/path/easytransfer-events.sqlite
